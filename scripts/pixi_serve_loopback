#!/usr/bin/env bash
#
# Run a `pixi` subcommand against a freshly-spawned `pixi serve`.
#
#   scripts/pixi_serve_loopback [<server-args>... --] <client-args>...
#
# Spawns `pixi <server-args> serve --socket $tmp/pixi.sock` in the background,
# waits for the socket to appear, then runs
# `pixi <client-args> --socket $tmp/pixi.sock` against it.
#
# Without a `--` separator, *all* arguments go to the client and the server is
# spawned with no extra arguments — i.e. the previous behaviour. To pass flags
# (like `-vv`) through to the server, separate them with `--`:
#
#   PIXI=./target/debug/pixi scripts/pixi_serve_loopback -vv -- serve-test ping
#
# Each line is prefixed with `SERVER (out): ` / `SERVER (err): ` for the
# server and `CLIENT (out): ` / `CLIENT (err): ` for the client so the two
# processes' output channels can be told apart in interleaved output. The
# server is killed and the tempdir removed on exit.
#
# Override which binary is invoked by setting `$PIXI` (default: `pixi` from
# PATH).
#
set -euo pipefail

readonly PIXI="${PIXI:-pixi}"

# Split $@ on `--`. Without the separator, everything is for the client and
# the server gets no extra args (preserves the original calling convention).
server_extra_args=()
client_args=()
seen_separator=false
for arg in "$@"; do
    if "$seen_separator"; then
        client_args+=("$arg")
    elif [[ "$arg" == "--" ]]; then
        seen_separator=true
    else
        server_extra_args+=("$arg")
    fi
done
if ! "$seen_separator"; then
    client_args=("${server_extra_args[@]}")
    server_extra_args=()
fi

if (( ${#client_args[@]} == 0 )); then
    echo "usage: $(basename "$0") [<server-args>... --] <client-args>..." >&2
    exit 2
fi

# ANSI markers for the SERVER / CLIENT tags. Bold cyan and magenta — distinct
# from one another and from the conventional red/green/yellow that already
# carry meaning in shell tooling. Honours `NO_COLOR` and only emits the codes
# when the *target* stream is a TTY, so redirects keep clean output.
readonly cyan=$'\033[1;36m' magenta=$'\033[1;35m' reset=$'\033[0m'
if [[ -z "${NO_COLOR:-}" ]] && [[ -t 1 ]]; then
    out_server="${cyan}SERVER (out):${reset}"
    out_client="${magenta}CLIENT (out):${reset}"
else
    out_server='SERVER (out):'
    out_client='CLIENT (out):'
fi
if [[ -z "${NO_COLOR:-}" ]] && [[ -t 2 ]]; then
    err_server="${cyan}SERVER (err):${reset}"
    err_client="${magenta}CLIENT (err):${reset}"
else
    err_server='SERVER (err):'
    err_client='CLIENT (err):'
fi

# Read stdin line-by-line and write it to stdout with `$1 ` prepended. Uses
# `read -r` so each line is forwarded as soon as it is complete — no buffering
# tricks needed (and no dependency on GNU `sed -u` / BSD `sed -l`). The
# trailing-line guard handles processes that don't terminate their final line
# with a newline.
prefix_stream() {
    local prefix="$1" line
    while IFS= read -r line || [[ -n "$line" ]]; do
        printf '%s %s\n' "$prefix" "$line"
    done
}

tmp="$(mktemp -d -t pixi-serve-loopback.XXXXXX)"
socket="$tmp/pixi.sock"
server_pid=""

cleanup() {
    if [[ -n "$server_pid" ]] && kill -0 "$server_pid" 2>/dev/null; then
        kill "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
    # Drain any prefix_stream subshells the server left behind so their final
    # lines aren't lost when the script exits.
    wait 2>/dev/null || true
    rm -rf "$tmp"
}
trap cleanup EXIT

# Server-extra args go *before* `serve` so global flags (e.g. `-vv`) parse
# in their conventional position; clap accepts them later too, but this is
# the form humans copy out of the help text.
"$PIXI" "${server_extra_args[@]}" serve --socket "$socket" \
    > >(prefix_stream "$out_server") \
    2> >(prefix_stream "$err_server" >&2) &
server_pid=$!

# Poll for the socket. If the server crashes before binding, bail out
# instead of timing out silently.
for _ in $(seq 1 100); do
    if [[ -S "$socket" ]]; then
        break
    fi
    if ! kill -0 "$server_pid" 2>/dev/null; then
        echo "pixi_serve_loopback: pixi serve exited before binding $socket" >&2
        wait "$server_pid" 2>/dev/null || true
        server_pid=""
        exit 1
    fi
    sleep 0.05
done

if [[ ! -S "$socket" ]]; then
    echo "pixi_serve_loopback: timed out waiting for $socket" >&2
    exit 1
fi

# Run the client. `set -e` would bail on a non-zero exit from the client, but
# we want to forward the exit code through cleanup, so disarm it here.
set +e
"$PIXI" "${client_args[@]}" --socket "$socket" \
    > >(prefix_stream "$out_client") \
    2> >(prefix_stream "$err_client" >&2)
client_status=$?
set -e

# Kill the server eagerly now that the client is done, instead of relying on
# the EXIT trap. This guarantees the server is gone before the script
# returns control, so callers never see lingering output or a still-bound
# socket race with the next invocation.
if [[ -n "$server_pid" ]] && kill -0 "$server_pid" 2>/dev/null; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
fi
server_pid=""

exit "$client_status"
