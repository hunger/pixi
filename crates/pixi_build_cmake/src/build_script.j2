{%- set is_cmd_exe = build_platform == "windows" -%}
{%- macro env(key) -%}
{%- if is_cmd_exe %}{{ "%" ~ key ~ "%" }}{% else %}{{ "$" ~key }}{% endif -%}
{% endmacro -%}

{# - Set up common variables -#}
{%- set library_prefix =  "%LIBRARY_PREFIX%" if is_cmd_exe else "$PREFIX" -%}
{%- set separator = "\\" if is_cmd_exe else "/" -%}
{%- set current_dir = "%CD%" if is_cmd_exe else "$(pwd)" -%}
{%- set toolchain_file = "conda-toolchain.cmake" -%}
{%- set query_dir = ".cmake" ~ separator ~ "api" ~ separator ~ "v1" ~ separator ~ "query" ~ separator ~ file_api_client -%}
{%- set toolchain_path = current_dir ~ separator ~ toolchain_file -%}
{%- set provider_file = discovery_dir ~ separator ~ "pixi-provider.cmake" -%}
{%- set find_log = discovery_dir ~ separator ~ find_log_name -%}

{# `${PYTHON_ARG:+...}` and `%PYTHON_ARG%` both vanish when the probe below
   found no interpreter -#}
{%- set python_arg = "%PYTHON_ARG%" if is_cmd_exe else "${PYTHON_ARG:+\"$PYTHON_ARG\"}" -%}

{# Set up default CMake arguments -#}
{%- set cmake_args = [env("CMAKE_ARGS")] -%}

{# Pin the compilers through the generated toolchain file -#}
{%- if toolchain_file_lines -%}
{%- set cmake_args = cmake_args + [
    "-DCMAKE_TOOLCHAIN_FILE=\"" ~ toolchain_path ~ "\""
] -%}
{% endif -%}

{%- set cmake_args = cmake_args + [
    "-GNinja",
    "-S \"" ~ source_dir ~ "\"",
    "-DCMAKE_BUILD_TYPE=Release",
    "-DCMAKE_INSTALL_PREFIX=\"" ~ library_prefix ~ "\"",
    "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
    "-DBUILD_SHARED_LIBS=ON",
    python_arg,
] + extra_args
-%}

{# The discovery run only has to reach the find_package() calls, so it skips
   the toolchain file, which lives in the build directory it never enters. -#}
{%- set discovery_args = [
    env("CMAKE_ARGS"),
    "-GNinja",
    "-S \"" ~ source_dir ~ "\"",
    "-B " ~ discovery_dir,
    "-DCMAKE_PROJECT_TOP_LEVEL_INCLUDES=\"" ~ current_dir ~ separator ~ provider_file ~ "\"",
] + extra_args -%}

{#- Output version information -#}
ninja --version
cmake --version

{# Point CMake at the python interpreter when one is present in the host
   environment. $PYTHON is set by rattler-build whether or not python is
   installed, so the probe has to test the filesystem.

   The flag is kept in its own variable rather than appended to CMAKE_ARGS,
   which is expanded unquoted below: a path holding a space would be split
   into two arguments there, and quoting it inside the string would not help,
   as the shell removes no quotes from the result of an expansion. -#}
{% if is_cmd_exe -%}
set PYTHON_ARG=
if exist "%PYTHON%" set PYTHON_ARG=-DPython_EXECUTABLE="%PYTHON%"
{% else -%}
PYTHON_ARG=
if [ -x "$PYTHON" ]; then
    PYTHON_ARG=-DPython_EXECUTABLE="$PYTHON"
fi
{% endif -%}

{# Find out what the project searches for, in a throwaway build tree. The
   provider stands in for whatever is missing, so a single run reports every
   package instead of stopping at the first one that cannot be found. The real
   configure below runs afterwards, in its own directory and without it. -#}
{% if is_cmd_exe -%}
if not exist {{ build_dir }}\build.ninja (
    if not exist {{ discovery_dir }} mkdir {{ discovery_dir }}
{%- for line in provider_file_lines %}
    {{ ">" if loop.first else ">>" }}{{ provider_file }} echo {{ line | replace("(", "^(") | replace(")", "^)") | replace("|", "^|") }}
{%- endfor %}
    cmake {{ discovery_args | join(" ^\n        ") }} > {{ discovery_dir }}\configure.log 2>&1
    if errorlevel 1 echo stopped>> {{ find_log }}
    findstr /b "missing" {{ find_log }} > nul 2>&1 && echo pixi-build-cmake: packages the project looked for and did not find: & findstr /b "missing" {{ find_log }}
)
{% else -%}
if [ ! -f "{{ build_dir }}/build.ninja" ]; then
    mkdir -p {{ discovery_dir }}
    cat > {{ provider_file }} <<'EOF'
{% for line in provider_file_lines %}{{ line }}
{% endfor %}EOF
    cmake {{ discovery_args | join(" \\\n        ") }} > {{ discovery_dir }}/configure.log 2>&1 \
        || echo "stopped" >> {{ find_log }}
    grep '^missing ' {{ find_log }} 2>/dev/null \
        | sed 's/^missing \([^ ]*\) \(.*\)/pixi-build-cmake: \2 (\1) was not found/'
fi
{% endif %}
{# Set up the build directory -#}
{% if is_cmd_exe -%}
if not exist {{ build_dir }} mkdir {{ build_dir }}
{% else -%}
mkdir -p {{ build_dir }}
{% endif -%}
pushd {{ build_dir }}

{# Ask CMake to describe the project, so the backend can read the files it
   declares from the reply that every configure run writes -#}
{% if is_cmd_exe -%}
if not exist {{ query_dir }} mkdir {{ query_dir }}
>{{ query_dir }}\query.json echo {{ file_api_query }}
{% else -%}
mkdir -p {{ query_dir }}
cat > {{ query_dir }}/query.json <<'EOF'
{{ file_api_query }}
EOF
{% endif %}
{# Both branches below configure, then check for the install target before
   building. CMake emits that target only once the project installs
   something, and ninja's `unknown target install` after a full build would
   otherwise be the first sign that install() is missing. The check needs a
   ninja build tree to query, so it stands aside for another generator. -#}
{# Windows -#}
{% if is_cmd_exe -%}
if not exist build.ninja (
{%- for line in toolchain_file_lines %}
    {{ ">" if loop.first else ">>" }}{{ toolchain_file }} echo {{ line | replace("(", "^(") | replace(")", "^)") }}
{%- endfor %}
    cmake {{ cmake_args | join(" ^\n        ") }}
    @if errorlevel 1 exit 1
)

if exist build.ninja (
    ninja -t query install > nul 2>&1
    if errorlevel 1 (
        echo pixi-build-cmake: the project has no install^(^) rules, so the package would hold no files. 1>&2
        echo pixi-build-cmake: add an install^(^) call to CMakeLists.txt naming what the package should ship. 1>&2
        exit 1
    )
)

cmake --build . --target install
@if errorlevel 1 exit 1

{# Non Windows #}
{% else -%}
if [ ! -f "build.ninja" ]; then
{%- if toolchain_file_lines %}
    cat > {{ toolchain_file }} <<'EOF'
{% for line in toolchain_file_lines %}{{ line }}
{% endfor %}EOF
{%- endif %}
    cmake {{ cmake_args | join(" \\\n        ") }}
fi

if [ -f "build.ninja" ] && ! ninja -t query install > /dev/null 2>&1; then
    echo "pixi-build-cmake: the project has no install() rules, so the package would hold no files." >&2
    echo "pixi-build-cmake: add an install() call to CMakeLists.txt naming what the package should ship." >&2
    exit 1
fi

cmake --build . --target install
{% endif -%}
