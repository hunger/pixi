# Pixi workspace management over varlink IPC
interface dev.prefix.pixi

# A package that was installed.
type InstalledPackage (
    name: string,
    version: string
)

# Progress bar
type ProgressBar (
    Global,
    CondaSolve,
    PixiSolve,
    PixiInstall,
    FixPermissions
)

# Progress State
type ProgressState (
    Queued,
    Started,
    Finished
)

# A progress message
type Progress (
    progress_bar: ProgressBar,
    progress_state: ProgressState,
    id: int
)

# The response to ConfirmGlobalInstall
type ConfirmGlobalInstallResult (
    sha: string,
    sha_dir: string,
    packages: []InstalledPackage
)

# Install packages globally. Returns a challenge UUID. The client must create
# .pixi-server-auth-<challenge> in client_envs_dir, then call ConfirmGlobalInstall.
method GlobalInstall(
    packages: []string,
    channels: []string,
    platform: ?string,
    environment: ?string,
    expose: []string,
    with: []string,
    force_reinstall: bool,
    no_shortcuts: bool,
    client_envs_dir: string
) -> (challenge: string)

# Confirm that the auth file was created. The server checks for the file,
# installs the environment, and returns the result.
# With "more", the server streams progress as intermediate replies with only
# the "message" field set, followed by a final reply with the full result.
method ConfirmGlobalInstall(challenge: string) -> (
    progress: ?Progress,
    result: ?ConfirmGlobalInstallResult
)

error GlobalInstallFailed(message: string)
error AuthenticationFailed(challenge: string)
