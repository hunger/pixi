[Unit]
Description=Pixi Varlink Server

[Service]
Type=simple
ExecStart=pixi remote --address /run/pixi/pixi.sock serve --cache-dir /var/cache/pixi --envs-dir /var/lib/pixi

# Run as a dedicated static system user/group.
# Not DynamicUser=yes because clients need to traverse /var/lib/pixi directly
# (DynamicUser redirects StateDirectory into /var/lib/private/ which is 0700).
# Create the user with: systemd-sysusers pixi-varlink.conf
User=pixi
Group=pixi

# Cache directory: private to the service.
CacheDirectory=pixi
CacheDirectoryMode=0750

# State directory for pixi home (envs, manifests, bin): world-readable so
# other users can use installed environments.
StateDirectory=pixi
StateDirectoryMode=0755

# Nonce credential passed to the server via $CREDENTIALS_DIRECTORY/nonce.
# Generate an encrypted credential with:
#   systemd-creds encrypt --name=nonce - - <<< "$(openssl rand -hex 16)"
# Then replace SetCredential= with SetCredentialEncrypted= and the ciphertext.
SetCredential=nonce:pixi-varlink-default-nonce

# --- Filesystem hardening ---
ProtectSystem=strict
# read-only: the server needs to read auth challenge files that clients
# create in their home directories.
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/var/cache/pixi /var/lib/pixi

# --- Network hardening ---
# AF_UNIX for the varlink socket, AF_INET/AF_INET6 for package downloads.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# --- Privilege hardening ---
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# --- Device and IPC isolation ---
PrivateDevices=yes
RemoveIPC=yes

# --- Memory and execution hardening ---
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes

# --- System call filter ---
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# --- Capabilities ---
CapabilityBoundingSet=
AmbientCapabilities=

# --- Misc ---
UMask=0022

# --- Logging ---
# Log level is controlled by RUST_LOG. Examples:
#   error   - errors only (default)
#   warn    - errors and warnings
#   info    - startup, shutdown, config
#   debug   - individual requests and responses
#   trace   - full detail including pixi internals
#
# Override in a drop-in (systemctl edit pixi-varlink):
#   [Service]
#   Environment=RUST_LOG=info
#
# Or target specific crates:
#   Environment=RUST_LOG=pixi_varlink=debug,pixi_core=warn
